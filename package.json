{
  "name": "real-estate-property-mgmt",
  "version": "1.0.0",
  "description": "Real Estate Property Management API - Add, List, and Manage Properties",
  "main": "dist/src/web/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig-build.json",
    "start": "node dist/src/web/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/web/index.ts",
    "db:migrate": "sequelize-cli db:migrate --config sequelize.config.cjs --migrations-path migrations",
    "db:rollback": "sequelize-cli db:migrate:undo --config sequelize.config.cjs --migrations-path migrations",
    "lint": "eslint ./src/**/*.ts",
    "lint:fix": "eslint ./src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.4.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.45.0",
    "jest": "^29.6.2",
    "openapi-types": "^12.1.3",
    "rimraf": "^5.0.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
