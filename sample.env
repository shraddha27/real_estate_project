# Application
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# Logging
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/postgres

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# External APIs (optional)
API_TIMEOUT=5000
